# Maintainer: Joan Karadimov <joan.karadimov@gmail.com>

_realname=pyliblo3
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.17.0
# 0.17.0 is on PyPI as wheels only and is not tagged; this is its version commit.
_commit='029b83a03b4f24d905f818591903411753901273'
pkgrel=1
pkgdesc="Python bindings for the liblo OSC library (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://github.com/gesellkammer/pyliblo3'
license=('spdx:LGPL-2.1-or-later')
msys2_repository_url='https://github.com/gesellkammer/pyliblo3'
msys2_references=(
  'archlinux: python-pyliblo3'
  'purl: pkg:pypi/pyliblo3'
)
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-liblo")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cython"
             "${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools"
             "${MINGW_PACKAGE_PREFIX}-python-wheel")
options=('!strip')
source=("${_realname}-${_commit}.tar.gz::https://github.com/gesellkammer/pyliblo3/archive/${_commit}.tar.gz")
sha256sums=('a00d1bfbf7fcf77603cc62a98d8ee7f55a5906b370a82c9508d46a31d36e7d07')

build() {
  rm -rf "python-build-${MSYSTEM}"
  cp -r "${_realname}-${_commit}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  "${MINGW_PREFIX}/bin/python" -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "${srcdir}/python-build-${MSYSTEM}"
  rm -rf _install
  "${MINGW_PREFIX}/bin/python" -m installer --prefix= --destdir=_install dist/*.whl
  # Away from the source tree's pyliblo3/, which has no compiled extension.
  local _tests="${PWD}/test/unit.py"
  cd _install/lib/python*/site-packages
  PYTHONPATH=. "${MINGW_PREFIX}/bin/python" "${_tests}"
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    "${MINGW_PREFIX}/bin/python" -m installer --prefix=${MINGW_PREFIX} --destdir="${pkgdir}" dist/*.whl
  install -Dm644 COPYING -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
