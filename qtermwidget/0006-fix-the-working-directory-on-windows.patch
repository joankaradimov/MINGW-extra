@@ -476,7 +490,7 @@
     if (!m_proc || !m_proc->isAvailable()) {
         return -1;
     }
-    bool res = m_proc->startProcess(program, arguments, workingDir, environment, cols, lines);
+    bool res = m_proc->startProcess(program, arguments, workingDir.isEmpty() ? _workingDir : workingDir, environment, cols, lines);
     if (!res) {
         return -1;
     } else {
--- a/lib/ptyqt/conptyprocess.cpp
+++ b/lib/ptyqt/conptyprocess.cpp
@@ -4,6 +4,7 @@
