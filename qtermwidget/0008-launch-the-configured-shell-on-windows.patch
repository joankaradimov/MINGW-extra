+        // Change shell to cmd.exe if we don't have powershell
+        if (!QFile::exists(exec))
+            exec = QString::fromLocal8Bit(qgetenv("ComSpec"));
+        if (exec.isEmpty() || !QFile::exists(exec))
+            exec = QStringLiteral("C:\\WINDOWS\\system32\\cmd.exe");
