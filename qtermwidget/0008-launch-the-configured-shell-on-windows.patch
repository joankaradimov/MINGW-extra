+    // Honour the configured program, exactly as the Unix branch above does, and
+    // fall back only when it is unset or missing. ConPtyProcess demands an
+    // absolute path, so resolve a bare name against PATH first.
+    QString exec = _program;
+    if (!exec.isEmpty() && QFileInfo(exec).isRelative()) {
+        const QString resolved = QStandardPaths::findExecutable(exec);
+        if (!resolved.isEmpty())
+            exec = resolved;
+    }
