--- a/lib/tools.cpp
+++ b/lib/tools.cpp
@@ -2,8 +2,48 @@
 
 #include <QCoreApplication>
 #include <QDir>
+#include <QFileInfo>
 #include <QtDebug>
 
+#ifdef Q_OS_WIN
+#include <windows.h>
+
+/*! Directory holding the module (DLL) this function is compiled into.
+
+The library, not the application, owns kb-layouts and color-schemes, and a
+consumer executable need not live in the same directory as the DLL -- so
+QCoreApplication::applicationDirPath() is the wrong anchor for an installed
+prefix. Ask the loader where this code actually came from instead.
+*/
+static QString get_module_dir()
+{
+    HMODULE mod = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS
+                                | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            reinterpret_cast<LPCWSTR>(&get_module_dir),
+                            &mod))
+        return QString();
+
+    wchar_t buf[32768];
+    const DWORD n = GetModuleFileNameW(mod, buf, DWORD(sizeof(buf) / sizeof(buf[0])));
+    if (n == 0 || n >= DWORD(sizeof(buf) / sizeof(buf[0])))
+        return QString();
+
+    return QFileInfo(QString::fromWCharArray(buf, int(n))).absolutePath();
+}
+
+QString get_relocated_data_dir(const QString& subdir)
+{
+    const QString moduleDir = get_module_dir();
+    if (moduleDir.isEmpty())
+        return QString();
+
+    return QDir::cleanPath(moduleDir + QLatin1Char('/')
+                           + QLatin1String(QTERMWIDGET_DATA_RELDIR)
+                           + QLatin1Char('/') + subdir);
+}
+#endif
+
 
 Q_LOGGING_CATEGORY(qtermwidgetLogger, "qtermwidget", QtWarningMsg)
 
@@ -34,6 +74,16 @@
     if (d.exists())
         return QCoreApplication::applicationDirPath() + QLatin1String("/kb-layouts/");
 #endif
+#ifdef Q_OS_WIN
+    // installed prefix, found relative to this DLL
+    k = get_relocated_data_dir(QLatin1String("kb-layouts"));
+    if (!k.isEmpty())
+    {
+        d.setPath(k);
+        if (d.exists())
+            return k.append(QLatin1Char('/'));
+    }
+#endif
 #ifdef Q_OS_MAC
     d.setPath(QCoreApplication::applicationDirPath() + QLatin1String("/../Resources/kb-layouts/"));
     if (d.exists())
@@ -82,6 +132,19 @@
         rval << (QCoreApplication::applicationDirPath() + QLatin1String("/color-schemes/"));
     }
 #endif
+#ifdef Q_OS_WIN
+    // installed prefix, found relative to this DLL
+    if (rval.isEmpty())
+    {
+        QString w = get_relocated_data_dir(QLatin1String("color-schemes"));
+        if (!w.isEmpty())
+        {
+            d.setPath(w);
+            if (d.exists())
+                rval << w.append(QLatin1Char('/'));
+        }
+    }
+#endif
 #ifdef Q_OS_MAC
     d.setPath(QCoreApplication::applicationDirPath() + QLatin1String("/../Resources/color-schemes/"));
     if (d.exists())
