+    qint32 buildNumber = QSysInfo::kernelVersion().split(QLatin1String(".")).last().toInt();
+    if (buildNumber < CONPTY_MINIMAL_WINDOWS_VERSION)
+        return false;
+    return m_winContext.init();
+}
