_srcdir="ghidra-Ghidra_${pkgver}_build"
_jvmdir="java-${_javaver}-openjdk"

prepare() {
  cd "${srcdir}/${_srcdir}"

  local _p
  for _p in "${srcdir}"/00*.patch; do
    patch -Np1 -i "${_p}"
  done

  # It needs Z3's Java bindings, which MSYS2's z3 does not build.
  rm -r Ghidra/Extensions/SymbolicSummaryZ3

  local _f _sum
  for _f in java-sarif-2.1-modified.jar AXMLPrinter2.jar dbgmodel.tlb \
      "yajsw-stable-${_yajsw}.zip" "${_fidbs[@]}"; do
    _sum=$(sha256sum "${srcdir}/${_f}" | cut -d' ' -f1)
    grep -q "${_sum}" gradle/support/fetchDependencies.gradle \
      || { error "${_f} is not the one fetchDependencies.gradle names"; return 1; }
  done
  install -Dm644 "${srcdir}"/{java-sarif-2.1-modified,AXMLPrinter2}.jar \
    -t dependencies/flatRepo
  install -Dm644 "${srcdir}/dbgmodel.tlb" -t dependencies/Debugger-agent-dbgeng
  install -Dm644 "${srcdir}/yajsw-stable-${_yajsw}.zip" -t dependencies/GhidraServer
  install -Dm644 "${_fidbs[@]/#/${srcdir}/}" -t dependencies/fidb
  # Gradle checks everything it fetches against these checksums.
  install -Dm644 "${srcdir}/verification-metadata.xml" -t gradle

  grep -q "net.java.dev.jna:jna:${_jna}\"" Ghidra/Framework/Pty/build.gradle \
    || { error "Ghidra no longer bundles JNA ${_jna}"; return 1; }
  bsdtar -tf "${srcdir}/yajsw-stable-${_yajsw}.zip" | grep -q "/lib/core/jna/jna-${_yajsw_jna}.jar$" \
    || { error "YAJSW no longer bundles JNA ${_yajsw_jna}"; return 1; }
}

# Runs JNA $1's own Ant build with the targets that follow, jnidispatch.dll
# linked against MSYS2's libffi. JNA's Makefile knows MSYS2's shells by
# neither uname nor compiler, so OS and CC are given. Its MinGW rules link
# msvcrt and add --add-stdcall-alias, which lld rejects and x86_64 has no use
# for; clang's -W warns about DllMain's unused parameters under JNA's -Werror.
# These releases' Makefile is not safe under make -j: testlib2.dll links
# testlib.dll without depending on it (fixed on JNA's master).
_ant_jna() {
  local _v=$1; shift
  (cd "${srcdir}/jna-${_v}" && MAKEFLAGS= ant \
    -Ddynlink.native=true \
    -Dcflags_extra.native=-Wno-unused-parameter \
    -DCC=cc \
    -Dmake.OS=OS=win32 \
    "-DEXTRA_MAKE_OPTS=WINDRES=windres LIBS='-lffi -lpsapi' LDFLAGS='-o \$@ -shared'" \
    "$@")
}

# Replaces the jnidispatch libraries in the JNA jar $1, built by upstream for
# every platform, with the one built for JNA $2.
_swap_jnidispatch() {
  local _dir="${srcdir}/jna-$2/build/jar-swap"
  mkdir -p "${_dir}/com/sun/jna/win32-x86-64"
  cp "${srcdir}/jna-$2/build/native-win32-x86-64/jnidispatch.dll" \
    "${_dir}/com/sun/jna/win32-x86-64/"
  zip -q -d "$1" 'com/sun/jna/*/*jnidispatch*'
  (cd "${_dir}" && zip -q -X "$1" com/sun/jna/win32-x86-64/jnidispatch.dll)
}

build() {
  cd "${srcdir}/${_srcdir}"

  export JAVA_HOME="${MINGW_PREFIX}/lib/jvm/${_jvmdir}"
  export GRADLE_USER_HOME="${srcdir}/gradle"
  # Ghidra's Python packages build with MSYS2's setuptools and wheel, not
  # ones pip would look for in dependencies/.
  export PIP_NO_BUILD_ISOLATION=0

  # The empty Visual Studio directory keeps the natives on MinGW (0001).
  # Ghidra's build also looks in the local Maven repository; an empty one
  # keeps the builder's ~/.m2 out, so every jar comes checked from Maven
  # Central.
  gradle --no-daemon \
    -PVISUAL_STUDIO_INSTALL_DIR= \
    -Dmaven.repo.local="$(cygpath -w "${srcdir}/m2")" \
    -Ppython3="$(cygpath -w "${MINGW_PREFIX}/bin/python.exe")" \
    buildGhidra

  rm -rf "${srcdir}/stage" && mkdir "${srcdir}/stage"
  bsdtar -xf build/dist/ghidra_${pkgver}_DEV_*_win_x86_64.zip -C "${srcdir}/stage"

  # Ghidra's JNA and YAJSW's come with upstream's jnidispatch.dll, built
  # with Visual C++; both get one built here instead.
  local _ghidra=("${srcdir}"/stage/ghidra_*)
  _ant_jna ${_jna} native
  _swap_jnidispatch "${_ghidra}/Ghidra/Framework/Pty/lib/jna-${_jna}.jar" ${_jna}
  _ant_jna ${_yajsw_jna} native
  _swap_jnidispatch \
    "${_ghidra}/Ghidra/Features/GhidraServer/data/yajsw-stable-${_yajsw}/lib/core/jna/jna-${_yajsw_jna}.jar" \
    ${_yajsw_jna}
}

check() {
  local _ghidra=("${srcdir}"/stage/ghidra_*)
  rm -rf "${srcdir}/test" && mkdir "${srcdir}/test" && cd "${srcdir}/test"

  c++ -O2 -o test-ghidra.exe "${srcdir}/test-ghidra.cpp"
  # A Ghidra script's file is named after its class.
  cp "${srcdir}/test-ghidra.java" TestGhidra.java

  # What the launcher sets up, with settings and caches kept out of the
  # user's profile.
  local _test="$(cygpath -w "${PWD}")"
  JAVA_HOME="$(cygpath -w "${MINGW_PREFIX}/lib/jvm/${_jvmdir}")" \
  PATH="${MINGW_PREFIX}/lib/jvm/${_jvmdir}/bin:${PATH}" \
  XDG_CONFIG_HOME="${_test}\\config" \
  XDG_CACHE_HOME="${_test}\\cache" \
    "${_ghidra}/support/analyzeHeadless.bat" "${_test}" test \
      -import test-ghidra.exe \
      -scriptPath "${_test}" -postScript TestGhidra.java \
      -deleteProject 2>&1 | tee analyze.log
  grep -q 'test-ghidra: passed' analyze.log

  _ant_jna ${_jna} test
  _ant_jna ${_yajsw_jna} test

  # JNA on the jnidispatch.dll built here, from Ghidra's jars and YAJSW's;
  # Pty.jar and the libraries it uses are on both class paths for the
  # test's compilation.
  local _fw="${_ghidra}/Ghidra/Framework"
  local _yj="${_ghidra}/Ghidra/Features/GhidraServer/data/yajsw-stable-${_yajsw}/lib/core/jna"
  local _cp="${_fw}/Pty/lib/Pty.jar:${_fw}/Utility/lib/Utility.jar:$(ls "${_fw}"/Generic/lib/*.jar | tr '\n' ':')"
  "${MINGW_PREFIX}/lib/jvm/${_jvmdir}/bin/java" \
    -cp "$(cygpath -wp "${_fw}/Pty/lib/jna-${_jna}.jar:${_fw}/Pty/lib/jna-platform-${_jna}.jar:${_cp}")" \
    "${srcdir}/test-jna.java" 2>&1 | tee jna.log
  "${MINGW_PREFIX}/lib/jvm/${_jvmdir}/bin/java" \
    -cp "$(cygpath -wp "${_yj}/jna-${_yajsw_jna}.jar:${_yj}/jna-platform-${_yajsw_jna}.jar:${_cp}")" \
    "${srcdir}/test-jna.java" yajsw 2>&1 | tee -a jna.log
  [[ $(grep -c 'test-jna: passed' jna.log) == 2 ]]
}

package() {
  local _ghidra=("${srcdir}"/stage/ghidra_*)
  mkdir -p "${pkgdir}${MINGW_PREFIX}"/{lib,bin}
  cp -a "${_ghidra}" "${pkgdir}${MINGW_PREFIX}/lib/${_realname}"

  # Ghidra's scripts take the JDK from JAVA_HOME; the launchers point it at
  # this openjdk and put bin on PATH, where its executables and Ghidra's
  # natives find the MinGW DLLs. sed reads a backslash as an escape, hence
  # the doubled ones; --binary keeps the .cmd's CRLF line ends.
  local -A _launchers=(
    [ghidra]='ghidraRun.bat'
    [ghidra-analyzeHeadless]='support\\analyzeHeadless.bat'
  )
  local _name
  for _name in "${!_launchers[@]}"; do
    sed --binary -e "s|@JVMDIR@|${_jvmdir}|" -e "s|@SCRIPT@|${_launchers[${_name}]}|" \
      "${srcdir}/launcher.cmd" > "${pkgdir}${MINGW_PREFIX}/bin/${_name}.cmd"
    sed "s|@NAME@|${_name}|" "${srcdir}/launcher.sh" \
      > "${pkgdir}${MINGW_PREFIX}/bin/${_name}"
  done

  local _licdir="${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  install -Dm644 "${_ghidra}/LICENSE" -t "${_licdir}"
  cp -r "${_ghidra}/licenses" "${_licdir}/licenses"
  cp -r "${_ghidra}/GPL/licenses" "${_licdir}/GPL"

  # One directory per bundled library: the license Ghidra's module
  # manifests name for it, and whatever license and notice files its jar
  # carries. The extensions' manifests are inside their zips. DMG lists its
  # libraries in its own LICENSE.txt, and Ghidra takes YAJSW and the Gradle
  # wrapper as they come.
  local _ext="${srcdir}/extensions"
  rm -rf "${_ext}" && mkdir "${_ext}"
  local _z
  for _z in "${_ghidra}"/Extensions/Ghidra/*.zip; do
    bsdtar -xf "${_z}" -C "${_ext}"
  done
  local _m _file _lic _text _lib
  while IFS= read -r -d '' _m; do
    # Lines for other platforms' files name nothing shipped here.
    while read -r _ _ _ _file _lic; do
      [[ -e "${_m%/*}/${_file}" ]] || continue
      _lib=${_file##*/}
      for _text in "${_ghidra}"/{licenses,GPL/licenses}/"${_lic// /_}".*; do
        [[ -e "${_text}" ]] && break
      done
      install -Dm644 "${_text}" -t "${_licdir}/${_lib%.*}"
      _jar_licenses "${_m%/*}/${_file}" "${_licdir}/${_lib%.*}"
    done < <(tr -d '\r' < "${_m}" | grep '^MODULE FILE LICENSE:')
  done < <(find "${_ghidra}" "${_ext}" -name Module.manifest -print0)

  install -Dm644 "${_ghidra}/GPL/DMG/LICENSE.txt" -t "${_licdir}/dmg"
  local _yajsw_dir="${_ghidra}/Ghidra/Features/GhidraServer/data/yajsw-stable-${_yajsw}"
  install -Dm644 "${_yajsw_dir}/LICENSE.txt" -t "${_licdir}/yajsw"
  local _jar
  while IFS= read -r -d '' _jar; do
    _lib=${_jar##*/}
    _jar_licenses "${_jar}" "${_licdir}/yajsw/${_lib%.*}"
  done < <(find "${_yajsw_dir}" -name '*.jar' -print0)
  _jar_licenses "${_ghidra}/support/gradle/gradle-wrapper.jar" "${_licdir}/gradle-wrapper"
}

# Copies the license and notice files that the jar $1 carries, if any, into
# the directory $2.
_jar_licenses() {
  [[ $1 == *.jar ]] || return 0
  local _f
  while read -r _f; do
    mkdir -p "$2"
    bsdtar -xOf "$1" "${_f}" > "$2/${_f##*/}"
  done < <(bsdtar -tf "$1" | grep -i -E '^(META-INF/)?[^/]*(LICEN[CS]E|NOTICE|COPYING)[^/]*$')
}
