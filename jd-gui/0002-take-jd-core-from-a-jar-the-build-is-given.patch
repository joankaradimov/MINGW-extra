Take jd-core from a jar the build is given.

The all-in-one jar carried a copy of JD-Core, fetched as org.jd:jd-core
from JCenter, which no longer exists. The services now compile against
the jar -PjdCoreJar names, and the all-in-one jar finds it at run time
through the Class-Path that -PjdCoreClassPath puts in its manifest.

JD-Core-Version leaves jd-gui's manifest: jd-gui looks for it in every
manifest on the class path, and the one in jd-core.jar names the version
actually loaded.

Upstream: not submitted (packaging-specific)
Applies-to: all environments

diff --git a/build.gradle b/build.gradle
index 7ef704d..48a34ae 100644
--- a/build.gradle
+++ b/build.gradle
@@ -2,7 +2,6 @@ apply plugin: 'java'
 
 // Common configuration //
 rootProject.version='1.6.6'
-rootProject.ext.set('jdCoreVersion', '1.1.3')
 
 allprojects {
     apply plugin: 'eclipse'
@@ -49,7 +48,7 @@ jar {
         attributes 'Main-Class': 'org.jd.gui.App',
                 'SplashScreen-Image': 'org/jd/gui/images/jd_icon_128.png',
                 'JD-GUI-Version': project.version,
-                'JD-Core-Version': project.jdCoreVersion
+                'Class-Path': project.property('jdCoreClassPath')
     }
     exclude 'META-INF/licenses/**', 'META-INF/maven/**', 'META-INF/INDEX.LIST'
     exclude '**/ErrorStrip_*.properties', '**/RSyntaxTextArea_*.properties', '**/RTextArea_*.properties'
diff --git a/services/build.gradle b/services/build.gradle
index 87e0a5b..e48b03d 100644
--- a/services/build.gradle
+++ b/services/build.gradle
@@ -3,7 +3,8 @@ apply plugin: 'java'
 dependencies {
     implementation 'com.fifesoft:rsyntaxtextarea:3.0.4'
     implementation 'org.ow2.asm:asm:7.1'
-    implementation 'org.jd:jd-core:' + parent.jdCoreVersion
+    compileOnly files(project.property('jdCoreJar'))
+    testImplementation files(project.property('jdCoreJar'))
     implementation project(':api')
     testImplementation 'junit:junit:4.12'
 }
