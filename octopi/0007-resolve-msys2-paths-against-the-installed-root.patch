diff --git a/src/unixcommand.cpp b/src/unixcommand.cpp
index caaf105..8978971 100644
--- a/src/unixcommand.cpp
+++ b/src/unixcommand.cpp
@@ -31,6 +31,11 @@
 #include <QFile>
 #include <QFileInfo>
 #include <QCoreApplication>
+#ifdef Q_OS_WIN
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#endif
 #include <QByteArray>
 #include <QTextStream>
 #include <QtNetwork>
@@ -724,9 +729,62 @@ bool UnixCommand::doInternetPingTest()
 /*
  * Use standard Qt method to retrieve a binary path
  */
+/*
+ * MSYS2's / is a directory on a Windows drive, and octopi is a native program,
+ * so a path libalpm would accept is not one QFile can open. The tool is
+ * installed at <root>/<env>/bin, so the root is two directories above the
+ * executable's -- the same reasoning, from the same layout, that alpmrpc's
+ * client uses to find its server.
+ *
+ * This is only for paths under that root: /etc, /usr, /var. It is not a
+ * general translator and must not become one. /bin is a mount alias for
+ * /usr/bin and /c is C:, and neither survives being prefixed; converting
+ * those needs the mount table, which lives in msys-2.0.dll and is therefore
+ * out of reach from here. Nothing octopi opens itself is one of them.
+ */
+QString UnixCommand::msysRoot()
+{
+#ifdef Q_OS_WIN
+  // Not QCoreApplication::applicationDirPath(): the startup checks that need
+  // this run before the QApplication object exists.
+  static QString root;
+  if (root.isEmpty())
+  {
+    wchar_t buf[MAX_PATH];
+    DWORD n = GetModuleFileNameW(nullptr, buf, MAX_PATH);
+    QDir dir(QFileInfo(QString::fromWCharArray(buf, int(n))).absolutePath());
+    dir.cdUp();
+    dir.cdUp();
+    root = dir.absolutePath();
+  }
+  return root;
+#else
+  return QLatin1String("/");
+#endif
+}
+
+QString UnixCommand::msysPath(const QString& path)
+{
+#ifdef Q_OS_WIN
+  if (!path.startsWith(QLatin1Char('/')))
+    return path;
+  return QDir::cleanPath(msysRoot() + path);
+#else
+  return path;
+#endif
+}
+
 QString UnixCommand::findExecutable(const QString& exeName)
 {
-  return QStandardPaths::findExecutable(exeName);
+  QString path = QStandardPaths::findExecutable(exeName);
+#ifdef Q_OS_WIN
+  // pacman, paccache and the rest live in MSYS2, which is not on the PATH
+  // of a native process.
+  if (path.isEmpty())
+    path = QStandardPaths::findExecutable(
+             exeName, QStringList() << msysPath(QLatin1String("/usr/bin")));
+#endif
+  return path;
 }
 
 /*
