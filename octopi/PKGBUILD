# Maintainer: Joan Karadimov <joan.karadimov@gmail.com>

_realname=octopi
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.19.0
pkgrel=1
pkgdesc="A Qt frontend for pacman, driving MSYS2's libalpm from a native process (mingw-w64)"
arch=('any')
# ucrt64 only: qtermwidget is packaged for ucrt64 alone, and so is
# alpm_octopi_utils. Nothing here is environment-specific beyond that.
mingw_arch=('ucrt64')
url='https://github.com/aarnt/octopi'
license=('spdx:GPL-2.0-or-later')
msys2_repository_url='https://github.com/aarnt/octopi'
msys2_references=(
  'aur: octopi'
)
depends=("${MINGW_PACKAGE_PREFIX}-alpm_octopi_utils"
         "${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-qt6-base"
         "${MINGW_PACKAGE_PREFIX}-qt6-multimedia"
         # Not in any import table: it is the SVG image-format plugin, which
         # Qt6Gui loads at runtime to draw the tray icon.
         "${MINGW_PACKAGE_PREFIX}-qt6-svg"
         "${MINGW_PACKAGE_PREFIX}-qtermwidget"
         # MSYS packages, and deliberately so: what this drives is the MSYS2
         # installation it is inside. checkupdates and paccache are looked for
         # by name, in MSYS2's /usr/bin, by patch 0007.
         'pacman'
         'pacman-contrib')
# qt6-5compat is a build dependency only: CMake requires the Core5Compat
# component, but nothing links Qt6Core5Compat.dll in the end -- checked.
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-qt6-5compat"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-qt6-tools")
source=("${_realname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "0001-do-not-build-the-setuid-root-helper-on-windows.patch"
        "0002-there-is-no-root-to-refuse-on-windows.patch"
        "0003-compile-the-vendored-qtsolutions-windows-path-against-qt6.patch"
        "0004-do-not-require-libutil.patch"
        "0005-use-qt-s-portable-environment-api.patch"
        "0006-find-our-own-executable-without-proc.patch"
        "0007-resolve-msys2-paths-against-the-installed-root.patch"
        "0008-do-not-require-qt-sudo-on-windows.patch"
        "0009-ask-whether-there-is-a-database.patch"
        "0010-hand-alpm-octopi-utils-a-pacman-conf-it-can-open.patch"
        "0011-make-isoctotoolrunning-answer-which-tool-is-running.patch"
        "0012-make-isnotifierbusy-give-up-instead-of-spinning.patch"
        "0013-do-not-hand-a-detached-child-this-process-s-console.patch"
        "0014-default-the-terminal-font-to-the-system-fixed-pitch-one.patch"
        "0015-run-transactions-as-the-user.patch"
        "0016-there-is-no-aur-on-msys2.patch")
