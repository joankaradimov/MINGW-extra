prepare() {
  cd "${_realname}-${pkgver}"

  # 0001-0002 delete the privileged half: octphelper is setuid-root, and MSYS2
  # has no root. 0003-0006 are portability, and four of them are upstream bugs
  # rather than Windows special cases. 0007-0008 are the MSYS2 ones: where the
  # paths octopi opens itself live, and that qt-sudo is not among them.
  local _p
  for _p in "${source[@]}"; do
    case "${_p}" in
      *.patch) patch -Np1 -i "${srcdir}/${_p}" ;;
    esac
  done
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # USE_KF6NOTIFICATIONS is off: it would add a KDE Frameworks dependency for
  # desktop notifications the notifier can raise through Qt anyway.
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    "${MINGW_PREFIX}"/bin/cmake.exe \
      -B "build-${MSYSTEM}" \
      -S "${srcdir}/${_realname}-${pkgver}" \
      -G Ninja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DUSE_QTERMWIDGET6=ON \
      -DUSE_KF6NOTIFICATIONS=OFF \
      "${extra_config[@]}"

  "${MINGW_PREFIX}"/bin/cmake.exe --build "build-${MSYSTEM}"
}

check() {
  # octopi takes the MSYS2 root to be two directories above its executable and
  # will not start without <root>/usr/bin/checkupdates, so run it from a root
  # laid out that way.
  local _root="${srcdir}/check-root"
  install -Dm755 "build-${MSYSTEM}/octopi.exe" "${_root}${MINGW_PREFIX}/bin/octopi.exe"
  install -Dm755 /usr/bin/checkupdates "${_root}/usr/bin/checkupdates"
  QT_QPA_PLATFORM=offscreen "${_root}${MINGW_PREFIX}/bin/octopi.exe" -version \
    | tr -d '\r' | grep -x "Octopi ${pkgver}"
}

package() {
  # Upstream installs LICENSE to share/licenses/octopi itself, which is
  # already the path MSYS2 wants, so nothing is installed by hand here.
  DESTDIR="${pkgdir}" "${MINGW_PREFIX}"/bin/cmake.exe --install "build-${MSYSTEM}"
}
