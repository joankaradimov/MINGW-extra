Build against the system StormLib and CLI11 instead of the submodules

mpqcli carries StormLib and CLI11 as git submodules and pulls them in with
add_subdirectory(extern/...), so a build from a release tarball -- where
extern/StormLib and extern/CLI11 are empty directories -- stops at the
FATAL_ERROR telling the user to run `git submodule update`. Both libraries
are packaged separately for MSYS2, and vendoring a second copy of StormLib
into this package would ship two divergent builds of the same DLL.

Switch both to find_package(). The imported target names line up with what
the tree already uses: CLI11 exports CLI11::CLI11, and StormLib exports
StormLib::storm, which carries its own include directory and the
__STORMLIB_NO_STATIC_LINK__ definition. That makes the explicit
extern/StormLib/src include directory and the add_dependencies(mpqcli storm)
ordering edge redundant -- both referred to the in-tree copy -- so they go
too. The MSVC-only add_compile_definitions(__STORMLIB_NO_STATIC_LINK__) in
src/CMakeLists.txt is left alone; it is what a submodule build still needs.

Two smaller things fall out of building outside a checkout of this project:

  - `git rev-parse HEAD` runs with WORKING_DIRECTORY ${CMAKE_SOURCE_DIR} and,
    from an unpacked tarball, git walks up out of the source tree and answers
    with whatever repository happens to contain the build directory. `mpqcli
    version` then reports a commit belonging to an unrelated project. Let a
    GIT_COMMIT_HASH given on the command line win instead, so a packager can
    pin the real release commit.

  - The project has no install rule, only a runtime output directory. Add the
    obvious one so `cmake --install` places the binary.

Not yet sent upstream.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -25,44 +25,26 @@
 endif()
 
 # Determine git commit hash
-execute_process(
-    COMMAND git rev-parse HEAD
-    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
-    OUTPUT_STRIP_TRAILING_WHITESPACE
-    OUTPUT_VARIABLE GIT_COMMIT_HASH
-    RESULT_VARIABLE GIT_COMMIT_RESULT
-    ERROR_QUIET
-)
-if(NOT GIT_COMMIT_RESULT EQUAL 0 OR NOT GIT_COMMIT_HASH)
+if(NOT DEFINED GIT_COMMIT_HASH)
+    execute_process(
+        COMMAND git rev-parse HEAD
+        WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
+        OUTPUT_STRIP_TRAILING_WHITESPACE
+        OUTPUT_VARIABLE GIT_COMMIT_HASH
+        RESULT_VARIABLE GIT_COMMIT_RESULT
+        ERROR_QUIET
+    )
+endif()
+if(NOT GIT_COMMIT_HASH)
     set(GIT_COMMIT_HASH "unknown")
 endif()
 
 # Handle StormLib dependency
-if (NOT EXISTS "${CMAKE_SOURCE_DIR}/extern/StormLib/CMakeLists.txt")
-    message(FATAL_ERROR
-"Missing dependency: StormLib
-mpqcli requires the StormLib library.
-It is provided as a submodule of this repository.
-Did you forget to execute the following commands?
-   git submodule init
-   git submodule update")
-endif()
-
-add_subdirectory(extern/StormLib)
+find_package(StormLib REQUIRED)
 
 # Handle CLI11 dependency
 if(BUILD_MPQCLI)
-    if (NOT EXISTS "${CMAKE_SOURCE_DIR}/extern/CLI11/CMakeLists.txt")
-        message(FATAL_ERROR
-    "Missing dependency: CLI11
-    mpqcli requires the CLI11 library.
-    It is provided as a submodule of this repository.
-    Did you forget to execute the following commands?
-       git submodule init
-       git submodule update")
-    endif()
-
-    add_subdirectory(extern/CLI11)
+    find_package(CLI11 REQUIRED)
 
     # Add the main application
     add_subdirectory(src)
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -36,16 +36,14 @@
     gamerules.cpp
 )
 
-# Add dependencies
-add_dependencies(mpqcli storm)
-
 # Include directories
-target_include_directories(mpqcli SYSTEM PRIVATE
-    "${CMAKE_SOURCE_DIR}/extern/StormLib/src"
-)
 target_include_directories(mpqcli PRIVATE
     "${CMAKE_BINARY_DIR}"
 )
 
 # Link libraries
-target_link_libraries(mpqcli PRIVATE storm CLI11::CLI11)
+target_link_libraries(mpqcli PRIVATE StormLib::storm CLI11::CLI11)
+
+# Install
+include(GNUInstallDirs)
+install(TARGETS mpqcli RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
