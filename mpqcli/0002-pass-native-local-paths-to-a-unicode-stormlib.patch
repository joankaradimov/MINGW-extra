 namespace fs = std::filesystem;
 
+// StormLib takes local file names as TCHAR strings: wchar_t when it was built
+// with UNICODE on Windows (StormPort.h then defines STORMLIB_WIDE_CHAR), char
+// everywhere else.
+#ifdef STORMLIB_WIDE_CHAR
+using StormString = std::wstring;
+
+// Paths typed on the command line reach main() in the ANSI code page. Convert
+// them the way the ANSI StormLib's CreateFileA did. std::filesystem cannot be
+// used for this: constructed from a narrow string, libstdc++ decodes a path as
+// UTF-8 and libc++ as ANSI.
+static StormString StormArgPath(const std::string &path) {
+    if (path.empty()) {
+        return StormString();
+    }
+    const int length = static_cast<int>(path.size());
+    const int size = MultiByteToWideChar(CP_ACP, 0, path.data(), length, nullptr, 0);
+    StormString wide(static_cast<size_t>(size), L'\0');
+    MultiByteToWideChar(CP_ACP, 0, path.data(), length, &wide[0], size);
+    return wide;
+}
+
+static StormString StormFsPath(const fs::path &path) {
+    return path.wstring();
+}
+#else
+using StormString = std::string;
+
+static StormString StormArgPath(const std::string &path) {
+    return path;
+}
+
+static StormString StormFsPath(const fs::path &path) {
+    return path.u8string();
+}
+#endif
+
