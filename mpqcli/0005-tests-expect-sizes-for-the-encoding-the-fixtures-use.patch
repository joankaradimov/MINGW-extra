+# The locale fixtures write their non-ASCII text in Python's default
+# encoding, which decides the file sizes: UTF-8 on POSIX and in UTF-8
+# mode, the ANSI code page otherwise on Windows.
+WRITES_UTF8 = codecs.lookup(locale.getpreferredencoding(False)).name == "utf-8"
+
 
