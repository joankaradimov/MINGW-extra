From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joan Karadimov <joan.karadimov@gmail.com>
Date: Thu, 5 Nov 2026 23:40:03 +0200
Subject: [PATCH] Strip plugins after linking only when STRIP is set

On Windows BUILD_PLUGIN strips each plugin with a POST_BUILD
"COMMAND ${STRIP} <plugin>.dll". Only the MinGW cross toolchain files
set STRIP. In a native build the unquoted empty variable disappears,
the DLL's path becomes the command, and Windows shows a "no app is
associated" dialog for every plugin it builds. Add the step only when
there is a strip to run.

Upstream: not submitted
---
 cmake/modules/BuildPlugin.cmake | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/cmake/modules/BuildPlugin.cmake b/cmake/modules/BuildPlugin.cmake
index f69fafe..b64748d 100644
--- a/cmake/modules/BuildPlugin.cmake
+++ b/cmake/modules/BuildPlugin.cmake
@@ -86,7 +86,9 @@ MACRO(BUILD_PLUGIN PLUGIN_NAME)
 	ENDIF(LMMS_BUILD_APPLE)
 	IF(LMMS_BUILD_WIN32)
 		SET_TARGET_PROPERTIES(${PLUGIN_NAME} PROPERTIES PREFIX "")
-		ADD_CUSTOM_COMMAND(TARGET ${PLUGIN_NAME} POST_BUILD COMMAND ${STRIP} "$<TARGET_FILE:${PLUGIN_NAME}>")
+		IF(STRIP)
+			ADD_CUSTOM_COMMAND(TARGET ${PLUGIN_NAME} POST_BUILD COMMAND ${STRIP} "$<TARGET_FILE:${PLUGIN_NAME}>")
+		ENDIF()
 	ENDIF(LMMS_BUILD_WIN32)
 
 	SET_DIRECTORY_PROPERTIES(PROPERTIES ADDITIONAL_MAKE_CLEAN_FILES "${ER_H} ${plugin_MOC_out}")
