prepare() {
  # The bundled Carla holds symlinks bsdtar cannot create here, and
  # WANT_CARLA=OFF leaves it unused.
  bsdtar -xf "${_realname}_${pkgver}.tar.xz" \
    --exclude "${_realname}/plugins/carlabase/carla"
  cd "${_realname}"

  local _p
  for _p in "${srcdir}"/0*.patch; do
    patch -Np1 -i "${_p}"
  done

  # The copies the patches above replace with system libraries
  rm -r src/3rdparty/rpmalloc \
    plugins/MidiImport/portsmf \
    plugins/LadspaEffect/swh/gsm
  rm plugins/opl2/{fmopl.c,fmopl.h,opl.h,temuopl.cpp,temuopl.h}
  rm plugins/sid/{envelope,extfilt,filter,pot,sid,voice,wave}.{cc,h} \
    plugins/sid/{siddefs.h,spline.h,version.cc,wave6581_*.cc,wave8580_*.cc}
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # LMMS_BUILD_MSYS: upstream's switch for a native MSYS2 build; it skips
  # the 32-bit VST host, which needs a second, 32-bit toolchain.
  # WANT_CARLA=OFF: there is no Carla package to build against.
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DWANT_QT5=ON \
      -DWANT_PORTABLE_LAYOUT=OFF \
      -DLMMS_BUILD_MSYS=ON \
      -DWANT_CARLA=OFF \
      -S "${_realname}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

check() {
  cmake --build "build-${MSYSTEM}" --target tests
  QT_FORCE_STDERR_LOGGING=1 "build-${MSYSTEM}"/tests/tests.exe

  local _stage="${srcdir}/stage-${MSYSTEM}"
  rm -rf "${_stage}" "${srcdir}/check-${MSYSTEM}"
  DESTDIR="${_stage}" cmake --install "build-${MSYSTEM}" > /dev/null
  mkdir "${srcdir}/check-${MSYSTEM}" && cd "${srcdir}/check-${MSYSTEM}"

  cc -O2 -o wavpeak.exe "${srcdir}/test-wavpeak.c"
  cc -O2 -I"${srcdir}/${_realname}/include" -o ladspa.exe "${srcdir}/test-ladspa.c"

  # Every LADSPA library LMMS installs loads, and each plugin in it runs
  ./ladspa.exe "${_stage}${MINGW_PREFIX}"/lib/lmms/ladspa/*.dll

  # Each instrument that sounds with default settings renders sound
  # (Vibed's strings default to off). The staged lmms.exe finds its
  # plugins and data relative to itself. Qt takes the profile from Windows,
  # not USERPROFILE, so the configuration names every directory LMMS would
  # otherwise put there, and points STK at the installed rawwaves.
  local _w="$(cygpath -m "${PWD}")/work"
  cat > lmmsrc.xml <<EOF
<?xml version="1.0"?>
<!DOCTYPE lmms-config-file>
<lmms version="${pkgver}">
  <paths workingdir="${_w}/" laddir="${_w}/plugins/ladspa/" vstdir="${_w}/plugins/vst/" gigdir="${_w}/samples/gig/" sf2dir="${_w}/samples/soundfonts/" stkdir="$(cygpath -m "${MINGW_PREFIX}/share/stk/rawwaves")/"/>
</lmms>
EOF
  local _i
  for _i in OPL2 bitinvader kicker lb302 malletsstk monstro nes organic \
      papu sid tripleoscillator watsyn zynaddsubfx; do
    sed "s/@INSTRUMENT@/${_i}/g" "${srcdir}/test-project.mmp" > "${_i}.mmp"
    "${_stage}${MINGW_PREFIX}/bin/lmms.exe" -c lmmsrc.xml \
      render "${_i}.mmp" -f wav -o "${_i}.wav"
    ./wavpeak.exe "${_i}.wav"
  done
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_realname}/LICENSE.txt" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.txt"
}
