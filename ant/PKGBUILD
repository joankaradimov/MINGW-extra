validpgpkeys=('BC26C53AF531F8B4B3F5930AAFBD3AF8EAFA72DA') # Stefan Bodewig

_jvmdir="java-${_javaver}-openjdk"

prepare() {
  cd "${srcdir}/apache-ant-${pkgver}"
  patch -Np1 -i "${srcdir}/0001-bootstrap-from-msys2-shells-as-from-cygwin.patch"
  patch -Np1 -i "${srcdir}/0002-recognise-windows-junctions-on-java-26-and-later.patch"

  mkdir -p lib/optional
  local _jar
  for _jar in "${_optional[@]##*/}"; do
    cp "${srcdir}/${_jar}" lib/optional/
  done
}

build() {
  cd "${srcdir}/apache-ant-${pkgver}"
  export JAVA_HOME="${MINGW_PREFIX}/lib/jvm/${_jvmdir}"

  # The manual stays; its 38 MB of API documentation is left out.
  sh ./build.sh -Djavadoc.notrequired=true dist
}

check() {
  cd "${srcdir}/apache-ant-${pkgver}"
  export JAVA_HOME="${MINGW_PREFIX}/lib/jvm/${_jvmdir}"

  local _jar
  for _jar in "${_testlibs[@]##*/}"; do
    cp "${srcdir}/${_jar}" lib/optional/
  done
  # Without a script engine the <script> tests are left out or skip
  # themselves: JDK 15 dropped Nashorn, and none is pinned here. Ant puts
  # makepkg's SOURCE_DATE_EPOCH before the timestamps the tstamp tests set.
  env -u SOURCE_DATE_EPOCH sh ./build.sh -Djavadoc.notrequired=true test

  rm -rf "${srcdir}/test" && mkdir "${srcdir}/test"
  cp "${srcdir}/test-ant.xml" "${srcdir}/test/"
  "apache-ant-${pkgver}/bin/ant" -f "${srcdir}/test/test-ant.xml" | tee "${srcdir}/test/ant.log"
  grep -q 'test-ant: passed' "${srcdir}/test/ant.log"
}

package() {
  local _dist="${srcdir}/apache-ant-${pkgver}/apache-ant-${pkgver}"
  local _home="${pkgdir}${MINGW_PREFIX}/share/ant"
  mkdir -p "${_home}" "${pkgdir}${MINGW_PREFIX}"/{bin,share/doc}
  cp -r "${_dist}"/{bin,etc,lib} "${_home}/"
  cp -r "${_dist}/manual" "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"

  # The launchers default JAVA_HOME to this openjdk; the .cmd and .ps1 also
  # put bin on PATH, where its executables find the MinGW DLLs, and run
  # upstream's ant.bat. --binary keeps the .cmd's CRLF line ends.
  sed --binary "s|@JVMDIR@|${_jvmdir}|" "${srcdir}/launcher.cmd" \
    > "${pkgdir}${MINGW_PREFIX}/bin/ant.cmd"
  sed "s|@JVMDIR@|${_jvmdir}|" "${srcdir}/launcher.ps1" \
    > "${pkgdir}${MINGW_PREFIX}/bin/ant.ps1"
  sed "s|@JVMDIR@|${_jvmdir}|" "${srcdir}/launcher.sh" \
    > "${pkgdir}${MINGW_PREFIX}/bin/ant"

  install -Dm644 "${_dist}"/{LICENSE,NOTICE} -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
