diff --git a/make/common/native/Flags.gmk b/make/common/native/Flags.gmk
index b54da4fcf..7d2d6fda9 100644
--- a/make/common/native/Flags.gmk
+++ b/make/common/native/Flags.gmk
@@ -32,6 +32,12 @@ ifeq ($(INCLUDE), true)
 # like optimization level.
 ################################################################################
 
+# clang on Windows compiles and links like gcc there, so it also takes the
+# flags and libraries given to gcc on Windows.
+ifeq ($(TOOLCHAIN_TYPE)+$(call isTargetOs, windows), clang+true)
+  ALSO_WINDOWS_GCC := gcc_windows
+endif
+
 ################################################################################
 # $1 is the prefix of the file to be compiled
 # $2 is the prefix of the library, i.e. $$($1_BASE)
@@ -88,6 +94,7 @@ define SetupCompilerFlags
   # OPENJDK_TARGET_OS plus OPENJDK_TARGET_CPU pair dependent variables for CFLAGS.
   $1_EXTRA_CFLAGS := $$($1_CFLAGS_$(OPENJDK_TARGET_OS_TYPE)) $$($1_CFLAGS_$(OPENJDK_TARGET_OS)) \
       $$($1_CFLAGS_$(TOOLCHAIN_TYPE)) $$($1_CFLAGS_$(TOOLCHAIN_TYPE)_$(OPENJDK_TARGET_OS)) \
+      $$(if $(ALSO_WINDOWS_GCC), $$($1_CFLAGS_$(ALSO_WINDOWS_GCC))) \
       $$($1_CFLAGS_$(OPENJDK_TARGET_OS)_$(OPENJDK_TARGET_CPU))
 
   ifneq ($(DEBUG_LEVEL), release)
@@ -110,7 +117,8 @@ define SetupCompilerFlags
   # variables for CXXFLAGS, and additionally the pair dependent TOOLCHAIN_TYPE plus
   # OPENJDK_TARGET_OS.
   $1_EXTRA_CXXFLAGS := $$($1_CXXFLAGS_$(OPENJDK_TARGET_OS_TYPE)) $$($1_CXXFLAGS_$(OPENJDK_TARGET_OS)) \
-      $$($1_CXXFLAGS_$(TOOLCHAIN_TYPE)) $$($1_CXXFLAGS_$(TOOLCHAIN_TYPE)_$(OPENJDK_TARGET_OS))
+      $$($1_CXXFLAGS_$(TOOLCHAIN_TYPE)) $$($1_CXXFLAGS_$(TOOLCHAIN_TYPE)_$(OPENJDK_TARGET_OS)) \
+      $$(if $(ALSO_WINDOWS_GCC), $$($1_CXXFLAGS_$(ALSO_WINDOWS_GCC)))
 
   ifneq ($(DEBUG_LEVEL), release)
     # Pickup extra debug dependent variables for CXXFLAGS
@@ -224,9 +232,11 @@ define SetupLinkerFlags
   # dependent variables for LDFLAGS and LIBS, and additionally the pair dependent
   # TOOLCHAIN_TYPE plus OPENJDK_TARGET_OS
   $1_EXTRA_LDFLAGS += $$($1_LDFLAGS_$(OPENJDK_TARGET_OS_TYPE)) $$($1_LDFLAGS_$(OPENJDK_TARGET_OS)) \
-      $$($1_LDFLAGS_$(TOOLCHAIN_TYPE)) $$($1_LDFLAGS_$(TOOLCHAIN_TYPE)_$(OPENJDK_TARGET_OS))
+      $$($1_LDFLAGS_$(TOOLCHAIN_TYPE)) $$($1_LDFLAGS_$(TOOLCHAIN_TYPE)_$(OPENJDK_TARGET_OS)) \
+      $$(if $(ALSO_WINDOWS_GCC), $$($1_LDFLAGS_$(ALSO_WINDOWS_GCC)))
   $1_EXTRA_LIBS += $$($1_LIBS_$(OPENJDK_TARGET_OS_TYPE)) $$($1_LIBS_$(OPENJDK_TARGET_OS)) \
-      $$($1_LIBS_$(TOOLCHAIN_TYPE)) $$($1_LIBS_$(TOOLCHAIN_TYPE)_$(OPENJDK_TARGET_OS))
+      $$($1_LIBS_$(TOOLCHAIN_TYPE)) $$($1_LIBS_$(TOOLCHAIN_TYPE)_$(OPENJDK_TARGET_OS)) \
+      $$(if $(ALSO_WINDOWS_GCC), $$($1_LIBS_$(ALSO_WINDOWS_GCC)))
 endef
 
 ################################################################################
