From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joan Karadimov <joan.karadimov@gmail.com>
Date: Sun, 4 Oct 2026 16:18:37 +0300
Subject: [PATCH 14/18] Leave out libjsvml when building with gcc

Its Windows sources are MASM. Rewriting them for GNU as is a 366k-line
change, and UASM 2.58 mis-encodes them (vcvtpd2ps xmm8 comes out as
xmm0). The Vector API computes these functions in Java without the
library.

Upstream: not submitted; part of the Windows/gcc port, not upstream OpenJDK
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 make/modules/jdk.incubator.vector/Lib.gmk | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/make/modules/jdk.incubator.vector/Lib.gmk b/make/modules/jdk.incubator.vector/Lib.gmk
index e6a05019f..cf15ab045 100644
--- a/make/modules/jdk.incubator.vector/Lib.gmk
+++ b/make/modules/jdk.incubator.vector/Lib.gmk
@@ -33,7 +33,10 @@ ifeq ($(INCLUDE_COMPILER2), true)
   ## Build libjsvml
   ##############################################################################
 
-  ifeq ($(call isTargetOs, linux windows)+$(call isTargetCpu, x86_64), true+true)
+  # The Windows sources are MASM, which gcc cannot assemble. Without the
+  # library the Vector API computes these functions in Java instead.
+  ifeq ($(call isTargetOs, linux windows)+$(call isTargetCpu, x86_64)+$(filter windows-gcc, \
+      $(OPENJDK_TARGET_OS)-$(TOOLCHAIN_TYPE)), true+true+)
     $(eval $(call SetupJdkLibrary, BUILD_LIBJSVML, \
         NAME := jsvml, \
         LDFLAGS_windows := -defaultlib:msvcrt, \
