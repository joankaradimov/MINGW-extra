+/*
+ * The MASM sources declare _fltused, which the Microsoft toolchain resolves
+ * from its C runtime. Other Windows toolchains have no definition, and lld
+ * fails the link on the undefined symbol although nothing refers to it.
+ */
+#ifndef _MSC_VER
+int _fltused;
+#endif
