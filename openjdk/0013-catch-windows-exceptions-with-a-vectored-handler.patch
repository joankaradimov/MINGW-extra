From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joan Karadimov <joan.karadimov@gmail.com>
Date: Sun, 4 Oct 2026 16:18:25 +0300
Subject: [PATCH 13/18] Catch Windows exceptions with a vectored handler under
 gcc

gcc has no __try/__except, so WIN32_TRY and WIN32_EXCEPT expand to
nothing and faults outside the code cache went unhandled: SafeFetch,
crash protection and error reporting for VM threads. Windows/AArch64
already runs on a vectored handler and static assembly SafeFetch; use
the same scheme for x64 with gcc.

Upstream: not submitted; part of the Windows/gcc port, not upstream OpenJDK
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/hotspot/os/windows/os_windows.cpp         |  8 ++-
 .../os_cpu/windows_x86/os_windows_x86.cpp     |  4 ++
 .../windows_x86/safefetch_windows_x86_64.S    | 59 +++++++++++++++++++
 src/hotspot/share/runtime/safefetch.hpp       |  2 +-
 .../share/utilities/globalDefinitions_gcc.hpp |  1 +
 5 files changed, 72 insertions(+), 2 deletions(-)
 create mode 100644 src/hotspot/os_cpu/windows_x86/safefetch_windows_x86_64.S

diff --git a/src/hotspot/os/windows/os_windows.cpp b/src/hotspot/os/windows/os_windows.cpp
index 5fe8d79f0..41e39ec58 100644
--- a/src/hotspot/os/windows/os_windows.cpp
+++ b/src/hotspot/os/windows/os_windows.cpp
@@ -2688,6 +2688,12 @@ LONG WINAPI topLevelExceptionFilter(struct _EXCEPTION_POINTERS* exceptionInfo) {
 #elif defined(_M_AMD64)
   address pc = (address) exceptionInfo->ContextRecord->Rip;
 
+#ifdef SAFEFETCH_METHOD_STATIC_ASSEMBLY
+  if (handle_safefetch(exception_code, pc, (void*)exceptionInfo->ContextRecord)) {
+    return EXCEPTION_CONTINUE_EXECUTION;
+  }
+#endif
+
   if ((exception_code == EXCEPTION_ACCESS_VIOLATION) &&
       VM_Version::is_cpuinfo_segv_addr(pc)) {
     // Verify that OS save/restore AVX registers.
@@ -2859,7 +2865,7 @@ LONG WINAPI topLevelExceptionFilter(struct _EXCEPTION_POINTERS* exceptionInfo) {
 
   bool should_report_error = (exception_code != EXCEPTION_BREAKPOINT);
 
-#if defined(_M_ARM64)
+#if defined(USE_VECTORED_EXCEPTION_HANDLING)
   should_report_error = should_report_error &&
                         FAILED(exception_code) &&
                         (exception_code != EXCEPTION_UNCAUGHT_CXX_EXCEPTION);
diff --git a/src/hotspot/os_cpu/windows_x86/os_windows_x86.cpp b/src/hotspot/os_cpu/windows_x86/os_windows_x86.cpp
index 01d8340a1..611aec2bf 100644
--- a/src/hotspot/os_cpu/windows_x86/os_windows_x86.cpp
+++ b/src/hotspot/os_cpu/windows_x86/os_windows_x86.cpp
@@ -197,6 +197,10 @@ bool handle_FLT_exception(struct _EXCEPTION_POINTERS* exceptionInfo) {
   return false;
 }
 
+void os::win32::context_set_pc(CONTEXT* uc, address pc) {
+  uc->Rip = (intptr_t)pc;
+}
+
 address os::fetch_frame_from_context(const void* ucVoid,
                     intptr_t** ret_sp, intptr_t** ret_fp) {
 
