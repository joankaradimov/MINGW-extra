+
+    # The Windows x64 calling convention, in GNU as syntax for gcc.
+    # Faults at the _fault labels are redirected to the _continuation
+    # labels by handle_safefetch() in safefetch_static_windows.cpp.
+
+    .text
+
+    # Support for int SafeFetch32(int* address, int defaultval);
+    #
+    #  %rcx : address
+    #  %edx : defaultval
+    .globl SafeFetch32_impl
+    .globl _SafeFetch32_fault
+    .globl _SafeFetch32_continuation
+SafeFetch32_impl:
+_SafeFetch32_fault:
+    movl (%rcx), %eax       # load target value, may fault
+    ret
+_SafeFetch32_continuation:
+    movl %edx, %eax         # return default
+    ret
+
+    # Support for intptr_t SafeFetchN(intptr_t* address, intptr_t defaultval);
+    #
+    #  %rcx : address
+    #  %rdx : defaultval
+    .globl SafeFetchN_impl
+    .globl _SafeFetchN_fault
+    .globl _SafeFetchN_continuation
+SafeFetchN_impl:
+_SafeFetchN_fault:
+    movq (%rcx), %rax       # load target value, may fault
+    ret
+_SafeFetchN_continuation:
+    movq %rdx, %rax         # return default
+    ret
diff --git a/src/hotspot/share/runtime/safefetch.hpp b/src/hotspot/share/runtime/safefetch.hpp
index 43872c781..2be81d475 100644
--- a/src/hotspot/share/runtime/safefetch.hpp
+++ b/src/hotspot/share/runtime/safefetch.hpp
@@ -31,7 +31,7 @@
 // Safefetch allows to load a value from a location that's not known
 // to be valid. If the load causes a fault, the error value is returned.
 
-#if defined(_WIN32) && !defined(_M_ARM64)
+#if defined(_WIN32) && !defined(_M_ARM64) && !defined(__GNUC__)
   // Windows x86_64 uses Structured Exception Handling
   #include "safefetch_windows.hpp"
 #elif defined(ZERO) || defined (_AIX)
diff --git a/src/hotspot/share/utilities/globalDefinitions_gcc.hpp b/src/hotspot/share/utilities/globalDefinitions_gcc.hpp
index 38b9cd473..c675f2ee4 100644
--- a/src/hotspot/share/utilities/globalDefinitions_gcc.hpp
+++ b/src/hotspot/share/utilities/globalDefinitions_gcc.hpp
@@ -91,6 +91,7 @@ inline int g_isfinite(jdouble f)                 { return isfinite(f); }
 
 #ifdef _WIN32
 #define M_PI 3.14159265358979323846
+#define USE_VECTORED_EXCEPTION_HANDLING
 #define WIN32_TRY
 #define WIN32_EXCEPT(filter) if (false)
 #endif
