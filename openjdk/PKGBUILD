_srcdir="jdk-${_tag/+/-}"
_jvmdir="${MINGW_PREFIX}/lib/jvm/java-${_majorver}-openjdk"

prepare() {
  cd "${srcdir}/${_srcdir}"

  local _p
  for _p in "${srcdir}"/00*.patch; do
    patch -Np1 -i "${_p}"
  done
}

build() {
  # OpenJDK chooses its own flags; makepkg's would turn the stack protector
  # back on, which the port turns off, and switch printf to mingw's.
  unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
  # The build runs its own parallel make.
  unset MAKEFLAGS

  local -a _debug=(--with-native-debug-symbols=none)
  if check_option "debug" "y"; then
    _debug=(--with-native-debug-symbols=internal)
  fi

  local _toolchain=gcc
  case "${MSYSTEM}" in
    CLANG*) _toolchain=clang ;;
  esac

  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  # The compilers here are newer than anything OpenJDK 27 is tested with,
  # and warn about code upstream compiles cleanly.
  bash "../${_srcdir}/configure" \
    --with-toolchain-type=${_toolchain} \
    --with-boot-jdk="${srcdir}/jdk-${_bootjdk}" \
    --with-gtest="${srcdir}/googletest-${_gtestver}" \
    --with-version-pre= \
    --with-version-opt= \
    --with-version-build=${_updatever} \
    --with-vendor-name=MINGW-extra \
    --with-vendor-url=https://github.com/joankaradimov/MINGW-extra \
    --with-vendor-bug-url=https://github.com/joankaradimov/MINGW-extra/issues \
    --with-vendor-vm-bug-url=https://github.com/joankaradimov/MINGW-extra/issues \
    --with-debug-level=release \
    "${_debug[@]}" \
    --with-stdc++lib=dynamic \
    --with-zlib=system \
    --with-libpng=system \
    --with-giflib=system \
    --with-libjpeg=system \
    --with-lcms=system \
    --with-harfbuzz=system \
    --with-freetype=system \
    --disable-warnings-as-errors

  make images
}

check() {
  cd "${srcdir}/build-${MSYSTEM}"
  unset MAKEFLAGS

  # HotSpot's unit tests; jtreg, which runs upstream's other tests, is not
  # packaged.
  make test-image-hotspot-gtest
  make test-only TEST=gtest

  ./images/jdk/bin/java "${srcdir}/test-openjdk.java"
}

package() {
  mkdir -p "${pkgdir}${_jvmdir}"
  cp -a "${srcdir}/build-${MSYSTEM}/images/jdk/." "${pkgdir}${_jvmdir}/"

  # The JDK finds itself from its own executables, so they stay in its
  # directory; MSYS2 shells get it on PATH.
  mkdir -p "${pkgdir}${MINGW_PREFIX}/etc/profile.d"
  sed "s|@JAVA_HOME@|${_jvmdir}|" "${srcdir}/openjdk.sh" \
    > "${pkgdir}${MINGW_PREFIX}/etc/profile.d/openjdk.sh"
  cp "${pkgdir}${MINGW_PREFIX}"/etc/profile.d/openjdk.{sh,zsh}

  # cmd and PowerShell get launchers in bin, shaped like the ones cmd-shim
  # writes for npm. They also put bin on PATH, where the JDK's executables
  # find the MinGW DLLs. --binary keeps the .cmd's CRLF line ends, which
  # cmd's GOTO and CALL rely on.
  mkdir -p "${pkgdir}${MINGW_PREFIX}/bin"
  local _exe _ext
  for _exe in "${pkgdir}${_jvmdir}"/bin/*.exe; do
    for _ext in cmd ps1; do
      sed --binary "s|@JVMDIR@|${_jvmdir##*/}|" "${srcdir}/launcher.${_ext}" \
        > "${pkgdir}${MINGW_PREFIX}/bin/$(basename "${_exe}" .exe).${_ext}"
    done
  done

  local _f
  for _f in LICENSE ASSEMBLY_EXCEPTION ADDITIONAL_LICENSE_INFO; do
    install -Dm644 "${srcdir}/build-${MSYSTEM}/images/jdk/legal/java.base/${_f}" \
      "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/${_f}"
  done
}
