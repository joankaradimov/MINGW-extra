_realname=openjdk
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
_majorver=27
_updatever=35
pkgver=${_majorver}.u${_updatever}
pkgrel=1
# OpenJDK builds with a JDK of its own or the previous major version. MSYS2
# has none, so the build runs on Adoptium's Temurin binaries; nothing of
# them is installed.
_bootjdk=27+35
_gtestver=1.14.0
pkgdesc="OpenJDK Java ${_majorver} development kit (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://openjdk.org/'
msys2_repository_url='https://github.com/openjdk/jdk'
msys2_references=(
  'archlinux: java-openjdk'
)
license=('spdx:GPL-2.0-only WITH Classpath-exception-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-freetype"
         "${MINGW_PACKAGE_PREFIX}-giflib"
         "${MINGW_PACKAGE_PREFIX}-harfbuzz"
         "${MINGW_PACKAGE_PREFIX}-lcms2"
         "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
         "${MINGW_PACKAGE_PREFIX}-libpng"
         "${MINGW_PACKAGE_PREFIX}-zlib")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             'autoconf'
             'make'
             'unzip'
             'zip')
# The build has no -g, so stripping would only drop the symbol tables that
# name the VM's functions in hs_err crash reports.
options=('!strip')
_tag=jdk-${_majorver}+${_updatever}
# The patches port the build to gcc and clang, starting from the Windows/gcc
# port in https://github.com/TheShermanTanker/jdk; each says where it comes
# from.
source=("${_realname}-${pkgver}.tar.gz::https://github.com/openjdk/jdk/archive/refs/tags/${_tag}.tar.gz"
        "https://github.com/adoptium/temurin${_bootjdk%%[.+]*}-binaries/releases/download/jdk-${_bootjdk/+/%2B}/OpenJDK${_bootjdk%%[.+]*}U-jdk_x64_windows_hotspot_${_bootjdk/+/_}.zip"
        "googletest-${_gtestver}.tar.gz::https://github.com/google/googletest/archive/refs/tags/v${_gtestver}.tar.gz"
        '0001-initial-support-for-gcc-on-windows.patch'
        '0002-move-attributes-for-gcc.patch'
        '0003-refactor-the-build-for-gcc-on-windows.patch'
        '0004-prefer-discarding-static-cast-over-do-while.patch'
        '0005-use-lowercase-windows-header-names.patch'
        '0006-keep-mingw-w64-stdio-functions-off-the-forbidden-list.patch'
        '0007-include-dlfcn-h-only-where-it-exists.patch'
        '0008-rewrite-drive-letters-in-gcc-dependency-files.patch'
        '0009-find-the-stack-pointer-without-an-msvc-intrinsic.patch'
        '0010-define-somaxconn-hint-where-winsock2-h-lacks-it.patch'
        '0011-embed-gcc-launcher-manifests-that-windows-accepts.patch'
        '0012-give-jpackage-msvc-libraries-only-under-msvc.patch'
        '0013-catch-windows-exceptions-with-a-vectored-handler.patch'
        '0014-leave-out-libjsvml-when-building-with-gcc.patch'
        '0015-allow-system-freetype-with-gcc-on-windows.patch'
        '0016-load-the-bundled-freetype-only-when-there-is-one.patch'
        '0017-decode-only-addresses-that-lie-in-a-module.patch'
        '0018-mark-the-gcc-decoders-raw-allocations-as-deliberate.patch'
        '0019-name-the-windows-only-gcc-settings-for-windows.patch'
        '0020-build-with-clang-on-windows.patch'
        '0021-include-errno-h-where-winntfilesystem-sets-enomem.patch'
        '0022-mark-the-gss-api-exports-for-every-windows-compiler.patch'
        '0023-quote-the-dialog-menu-name-for-llvm-rc.patch'
        'launcher.cmd'
        'launcher.ps1'
        'openjdk.sh'
        'test-openjdk.java')
sha256sums=('73e6536bbcc31a5397bdb91ef976109bb648d794c3628e43908463647c54bd76'
