--- a/test/jdk/java/awt/JAWT/Makefile.win
+++ b/test/jdk/java/awt/JAWT/Makefile.win
@@ -20,7 +20,7 @@
 # questions.
 
 CFLAGS =	-nologo
-OBJS =		myfile.obj
+OBJS =		myfile.o
 HEADERS =	MyCanvas.h
 CLASSES =	MyCanvas.class
 
@@ -36,10 +36,10 @@ all:		$(CLASSES) mylib.dll
