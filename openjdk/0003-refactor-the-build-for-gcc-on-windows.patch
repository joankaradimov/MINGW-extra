         endif
@@ -192,13 +192,13 @@ define ResolveLibPath
     ifeq ($$($1_$2_NAME), jvm)
       ifeq ($(TOOLCHAIN_TYPE), microsoft)
         ifeq ($(STATIC_LIBS), true)
-          $1_$2_LIBPATH := $$(JVM_OUTPUTDIR)/gtest/objs/static
+          $1_$2_LIBPATH := $$(JVM_OUTPUTDIR)/gtest/objects/static
         else
-          $1_$2_LIBPATH := $$(JVM_OUTPUTDIR)/gtest/objs
+          $1_$2_LIBPATH := $$(JVM_OUTPUTDIR)/gtest/objects
         endif
       else
         ifeq ($(STATIC_LIBS), true)
-          $1_$2_LIBPATH := $$(JVM_OUTPUTDIR)/gtest/objs/static
