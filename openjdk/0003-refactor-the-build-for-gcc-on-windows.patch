From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheShermanTanker <tanksherman27@gmail.com>
Date: Wed, 9 Mar 2022 20:36:48 +0800
Subject: [PATCH] Refactor

From the Windows/gcc port in https://github.com/TheShermanTanker/jdk,
branch experimental, commit dc01c7cb, rebased onto jdk-27+35. The rebranding
to Java and Java HotSpot, and its replacement icons, are left out.

Upstream: JEP draft 8288293 (https://openjdk.org/jeps/8288293), not merged
---
 make/StaticLibsImage.gmk                           |  4 ++--
 make/UpdateX11Wrappers.gmk                         |  2 +-
 make/common/JdkNativeCompilation.gmk               | 12 ++++++------
 make/hotspot/gensrc/GensrcAdlc.gmk                 |  2 +-
 make/hotspot/lib/CompileGtest.gmk                  |  6 +++---
 make/hotspot/lib/CompileJvm.gmk                    |  4 ++--
 make/ide/vscode/hotspot/indexers/ccls-settings.txt |  8 ++++----
 make/ide/vscode/hotspot/template-workspace.jsonc   |  4 ++--
 src/hotspot/share/runtime/abstract_vm_version.cpp  |  2 +-
 test/jdk/java/awt/JAWT/Makefile.win                |  8 ++++----
 10 files changed, 26 insertions(+), 26 deletions(-)

diff --git a/make/StaticLibsImage.gmk b/make/StaticLibsImage.gmk
index 6e00a3997..c442a8be7 100644
--- a/make/StaticLibsImage.gmk
+++ b/make/StaticLibsImage.gmk
@@ -58,9 +58,9 @@ ifneq ($(filter static-libs-image, $(MAKECMDGOALS)), )
   # Copy libjvm static library to the image.
   $(foreach v, $(JVM_VARIANTS), \
     $(eval $(call SetupCopyFiles, COPY_STATIC_LIBS_$v, \
-        SRC := $(HOTSPOT_OUTPUTDIR)/variant-$v/libjvm/objs/static, \
+        SRC := $(HOTSPOT_OUTPUTDIR)/variant-$v/libjvm/objects/static, \
         DEST := $(IMAGE_DEST_DIR)/$v, \
-        FILES := $(wildcard $(HOTSPOT_OUTPUTDIR)/variant-$v/libjvm/objs/static/*$(STATIC_LIBRARY_SUFFIX)), \
+        FILES := $(wildcard $(HOTSPOT_OUTPUTDIR)/variant-$v/libjvm/objects/static/*$(STATIC_LIBRARY_SUFFIX)), \
     )) \
     $(eval TARGETS += $$(COPY_STATIC_LIBS_$v)) \
     $(eval HOTSPOT_VARIANT_STATIC_LIBS_TARGETS += $$(COPY_STATIC_LIBS_$v)) \
diff --git a/make/UpdateX11Wrappers.gmk b/make/UpdateX11Wrappers.gmk
index 3ff2fc148..c07f94a3f 100644
--- a/make/UpdateX11Wrappers.gmk
+++ b/make/UpdateX11Wrappers.gmk
@@ -83,7 +83,7 @@ $(eval $(call SetupJdkExecutable, BUILD_DATA_GENERATOR, \
     CFLAGS := $(X_CFLAGS) $(DATA_GENERATOR_INCLUDES), \
     LIBS := $(X_LIBS), \
     OUTPUT_DIR := $(X11WRAPPERS_OUTPUT)/bin, \
-    OBJECT_DIR := $(X11WRAPPERS_OUTPUT)/objs, \
+    OBJECT_DIR := $(X11WRAPPERS_OUTPUT)/objects, \
 ))
 
 # Run the executable to create the data file.
diff --git a/make/common/JdkNativeCompilation.gmk b/make/common/JdkNativeCompilation.gmk
