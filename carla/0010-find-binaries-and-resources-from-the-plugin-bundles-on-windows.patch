@@ -98,6 +98,13 @@ public:
         File curExe = File::getSpecialLocation(File::currentExecutableFile).getLinkedTarget();
         File resDir = curExe.getSiblingFile("resources");
 
+#ifdef CARLA_OS_WIN
+        // No resources link in the bundle: <prefix>/lib/vst/carla.vst/<plugin>
+        if (! resDir.exists())
+            resDir = curExe.getParentDirectory().getParentDirectory().getParentDirectory().getParentDirectory()
+                     .getChildFile("share").getChildFile("carla").getChildFile("resources");
+#endif
+
 #ifndef CARLA_OS_MAC
         // FIXME: proper fallback path for other OSes
         if (! resDir.exists())
