Link the system ysfx

Carla compiles its own copy of ysfx, with WDL and dr_libs, into ysfx.a.
Link -lysfx instead, through YSFX_LIBS, and include <ysfx.h>.

Upstream: not submitted (upstream bundles its dependencies)
Applies-to: all environments

diff --git a/Makefile b/Makefile
index e151b3b..94f507f 100644
--- a/Makefile
+++ b/Makefile
@@ -89,7 +89,6 @@ ifeq ($(USING_RTAUDIO),true)
 3RD_LIBS += $(MODULEDIR)/rtmidi.a
 endif
 
-3RD_LIBS += $(MODULEDIR)/ysfx.a
 
 ALL_LIBS += $(3RD_LIBS)
 
