apply_patch_with_msg() {
  for _patch in "$@"; do
    msg2 "Applying ${_patch}"
    patch -Np1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  # bin/carla.lv2/resources links to a directory the build creates; tar
  # copies the tarball's other symlinks, which MSYS2 cannot create.
  rm -rf "Carla-${pkgver}"
  tar --exclude="Carla-${pkgver}/bin/carla.lv2/resources" -xzf "${_realname}-${pkgver}.tar.gz"
  cd "Carla-${pkgver}"

  apply_patch_with_msg \
    0001-allow-a-shared-windows-build.patch \
    0002-use-the-standard-thread-headers-in-hylia.patch \
    0003-link-the-system-zita-resampler.patch \
    0004-link-the-system-ysfx.patch \
    0005-follow-the-slider-api-of-ysfx-0.0.47.patch \
    0006-build-hylia-with-cxx17-for-ableton-link-4.patch \
    0007-take-the-asio-sdk-headers-from-asiosdk-flags.patch \
    0008-build-lilv-on-the-system-serd-sord-and-sratom.patch \
    0009-install-the-plugin-bundles-without-copies-on-windows.patch \
    0010-find-binaries-and-resources-from-the-plugin-bundles-on-windows.patch \
    0011-derive-pkg-config-dirs-from-the-prefix.patch \
    0012-normalise-path-separators-in-getpaths.patch

  # Its JUCE hunks have CRLF lines, as the files they change do.
  msg2 "Applying 0013-build-with-clang-on-mingw.patch"
  patch -Np1 --binary -i "${srcdir}/0013-build-with-clang-on-mingw.patch"
  apply_patch_with_msg 0014-name-the-native-plugin-dll-after-its-file.patch
  # water.cpp has CRLF lines.
  msg2 "Applying 0015-keep-water-s-dllmain-out-of-the-dll-exports.patch"
  patch -Np1 --binary -i "${srcdir}/0015-keep-water-s-dllmain-out-of-the-dll-exports.patch"
  apply_patch_with_msg 0016-search-the-prefix-plugin-folders-on-windows.patch

  # Copies of packaged libraries, and code the Windows build does not use
  # (RtAudio, JUCE's LV2 host). Carla's own forks stay part of its source:
  # its JUCE 7 modules, water, DPF, sfzero, and lilv, whose API differs from
  # upstream lilv.
  rm -r source/modules/{ysfx,zita-resampler,rtaudio,rtmidi,mingw-std-threads,rtaudio.diff} \
    source/modules/hylia/link/{ableton,asio,asio.hpp} \
    source/modules/lilv/{serd-0.24.0,sord-0.16.0,sratom-0.6.0,serd.c,sord.c,sratom.c} \
    source/modules/lilv/config/{serd,sord,sratom}_config.h \
    source/includes/{serd,sord,sratom} \
    source/modules/juce_audio_processors/format_types/LV2_SDK
}

_make() {
  local _debug=false
  check_option "debug" "y" && _debug=true

  make \
    WINDOWS_SHARED=true \
    ASIOSDK_FLAGS="-I${MINGW_PREFIX}/include/asiosdk/common" \
    SKIP_STRIPPING=true \
    DEBUG=${_debug} \
    "$@"
}

build() {
  rm -rf "build-${MSYSTEM}"
  cp -r "Carla-${pkgver}" "build-${MSYSTEM}"
  cd "build-${MSYSTEM}"

  _make

  ${CC} ${CFLAGS} ${LDFLAGS} -municode -mwindows \
    "${srcdir}/carla-ui-launcher.c" -o carla-ui-launcher.exe
}

check() {
  cd "build-${MSYSTEM}"
  local _stage="${srcdir}/stage-${MSYSTEM}"
  local _scratch="${srcdir}/scratch-${MSYSTEM}"
  rm -rf "${_stage}" "${_scratch}"
  mkdir -p "${_scratch}"
  _make DESTDIR="${_stage}" PREFIX="${MINGW_PREFIX}" install
  local _prefix="${_stage}${MINGW_PREFIX}"

  # The engine with internal, JSFX, LV2 and VST2 plugins.
  "${MINGW_PREFIX}/bin/python" "${srcdir}/test-carla-engine.py" "${_prefix}" "${_scratch}"

  # The frontend's default plugin folders include the prefix's lib/vst3 etc.
  "${MINGW_PREFIX}/bin/python" "${srcdir}/test-carla-plugin-paths.py" "${_prefix}"

  # A plugin host linked to the native plugin library, as LMMS's Carla
  # plugin is, loaded by a program.
  ${CC} -shared -DCARLA_TEST_HOST "${srcdir}/test-carla-native-plugin.c" \
    -o "${_scratch}/carla-test-host.dll" \
    $(PKG_CONFIG_PATH="${_prefix}/lib/pkgconfig" \
      pkg-config --define-prefix --cflags --libs carla-native-plugin)
  ${CC} "${srcdir}/test-carla-native-plugin.c" -o "${_scratch}/carla-test.exe"
  PATH="${_prefix}/lib/carla:${PATH}" \
    "${_scratch}/carla-test.exe" "$(cygpath -w "${_scratch}/carla-test-host.dll")"

  # Upstream's header tests, built against the installed headers and
  # libraries through Carla's pkg-config files. Not C89: the headers use //
  # comments and long long. Not run: they open every audio device on the
  # machine, and an ASIO driver may crash without its hardware.
  local _pkgflags _std _cxxstds=(c++98 c++11 c++17)
  # libc++ declares std::shared_ptr in C++98 too, where the headers define
  # their own.
  [[ ${MSYSTEM} == CLANG* ]] && _cxxstds=(c++11 c++17)
  _pkgflags=$(PKG_CONFIG_PATH="${_prefix}/lib/pkgconfig" \
    pkg-config --define-prefix --cflags --libs carla-standalone carla-utils)
  for _std in c99 c11; do
    ${CC} -std=${_std} -pedantic -Wall -Wextra -Werror source/tests/ansi-pedantic-test.c \
      ${_pkgflags} -o "${_scratch}/ansi-${_std}.exe"
  done
  for _std in "${_cxxstds[@]}"; do
    ${CXX} -std=${_std} -Wall -Wextra -Werror source/tests/ansi-pedantic-test.cpp \
      ${_pkgflags} -o "${_scratch}/ansi-${_std}.exe"
  done
}

package() {
  cd "build-${MSYSTEM}"
  _make DESTDIR="${pkgdir}" PREFIX="${MINGW_PREFIX}" install

  # Carla starts these UIs as <name>.exe on Windows; each one runs the
  # Python script of that name.
  local _ui
  for _ui in carla-plugin carla-plugin-patchbay bigmeter-ui midipattern-ui notes-ui xycontroller-ui; do
    install -Dm755 carla-ui-launcher.exe "${pkgdir}${MINGW_PREFIX}/share/carla/resources/${_ui}.exe"
  done

  # cmd.exe launchers beside upstream's sh ones.
  local _app
  for _app in carla carla-control carla-jack-multi carla-jack-single carla-patchbay carla-rack; do
    sed -e 's/\r$//' -e "s|@SCRIPT@|${_app}|" -e 's|@APPNAME@|--with-appname=%~n0 |' -e 's/$/\r/' \
      "${srcdir}/carla.cmd.in" > "${pkgdir}${MINGW_PREFIX}/bin/${_app}.cmd"
  done
  for _app in database settings; do
    sed -e 's/\r$//' -e "s|@SCRIPT@|carla_${_app}.py|" -e 's|@APPNAME@||' -e 's/$/\r/' \
      "${srcdir}/carla.cmd.in" > "${pkgdir}${MINGW_PREFIX}/bin/carla-${_app}.cmd"
  done

  local _licdir="${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  install -Dm644 doc/GPL.txt doc/LGPL.txt -t "${_licdir}"
  install -Dm644 source/modules/sfzero/LICENSE "${_licdir}/sfzero/LICENSE"
}
