--- a/test/cnf/precochk.c
+++ b/test/cnf/precochk.c
@@ -10,6 +10,20 @@
 #include <string.h>
 #include <zlib.h>
 
+/* A solver on Windows writes its output in text mode, ending lines with
+ * '\r\n'.  No '\r' means anything here, so skip them all.
+ */
+static int getc_skipping_cr (gzFile file) {
+  int ch;
+  do
+    ch = gzgetc (file);
+  while (ch == '\r');
+  return ch;
+}
+
+#undef gzgetc
+#define gzgetc getc_skipping_cr
+
 static void die (const char *msg, ...) {
   va_list ap;
   fputs ("*** precochk: ", stdout);
