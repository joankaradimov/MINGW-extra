From: Gentoo Linux
Subject: [PATCH] Do not override the user's CXXFLAGS

configure.in replaces CXXFLAGS with its own "-g -Wall -O2 ..." unless
$ac_test_CXXFLAGS is "set"; autoconf 2.71 and later set it to "y", so the
flags makepkg passes are thrown away.

Upstream: taken from Gentoo, media-libs/resid/files/resid-0.16_p2-drop-CXXFLAGS-override.patch
---
--- a/configure.in
+++ b/configure.in
@@ -26,20 +26,6 @@ AC_SUBST(RESID_INLINE)
 dnl Checks for programs.
 AC_PROG_CXX
 
-dnl Set CXXFLAGS for g++. Use -fno-exceptions if supported.
-if test "$GXX" = yes; then
-  if test "$ac_test_CXXFLAGS" != set; then
-    CXXFLAGS="-g -Wall -O2 -funroll-loops -fomit-frame-pointer -fno-exceptions"
-    AC_MSG_CHECKING([whether the C++ compiler ($CXX $CXXFLAGS $LDFLAGS) works])
-    AC_TRY_COMPILE([],
-                   [int test;],
-                   [ AC_MSG_RESULT(yes) ],
-                   [ AC_MSG_RESULT(no)
-                     CXXFLAGS="-g -Wall -O2 -funroll-loops -fomit-frame-pointer"
-                     ])
-  fi
-fi
-
 AC_PATH_PROG(PERL, perl)
 
 dnl Checks for libraries.
