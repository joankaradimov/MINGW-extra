Guard MSVC-only compile options

/permissive- is an MSVC switch, and so is ${ASAN} when a preset sets it
(/fsanitize=address). Passed unconditionally through add_compile_options(),
GCC and Clang take "/permissive-" for an input file and every compile fails.

src/mapping_core, src/map_gfx_utils and test/mapping_core already wrap the
line in a check of CMAKE_CXX_COMPILER_ID; give the seven other CMakeLists.txt
that set it the same guard. MSVC builds are unaffected.

Upstream: not submitted yet
Applies-to: all environments

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5bb49dc..b27a281 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,7 +10,9 @@ project(${This})
 set(CMAKE_BUILD_PARALLEL_LEVEL)
 set(CMAKE_C_STANDARD 99)
 set(CMAKE_CXX_STANDARD 20)
-add_compile_options(/permissive- ${ASAN})
+if ( "${CMAKE_CXX_COMPILER_ID}" MATCHES "MSVC" )
+  add_compile_options(/permissive- ${ASAN})
+endif ()
 add_compile_definitions(_UNICODE UNICODE NOMINMAX CHKDRAFT)
 
 include(FetchContent)
