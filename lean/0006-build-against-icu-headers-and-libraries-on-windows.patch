 #if defined(LEAN_WINDOWS)
-#include <icu.h>
+#include <unicode/ucal.h>
+#include <unicode/ustring.h>
 #include <windows.h>
 #include <io.h>
 #define NOMINMAX // prevent ntdef.h from defining min/max macros
