@@ -17,7 +17,23 @@ libtarg_name = $(proj_name)
 $(libtarg_name).lib : $+$(libtarg_prebuild_objs) $(libtarg_objs) $(libtarg_libs)$- $(__MAKEFILES__)
 !ifndef __WATCOM_TOOLS__
     @%make echo_lib
+! if defined( __GCC_TOOLS__ ) || defined( __CLANG_TOOLS__ )
+!  ifeq bld_os nt
+# GNU ar adds an archive as a plain member; an MRI script merges its objects
+# the way MSVC lib does
+    $(noecho)%create $^&.mri
+    $(noecho)%append $^&.mri CREATE $@
+    @for %o in ($+$(libtarg_objs)$-) do @%append $^&.mri ADDMOD %o
+    @for %l in ($+$(libtarg_libs)$-) do @%append $^&.mri ADDLIB %l
+    $(noecho)%append $^&.mri SAVE
+    $(noecho)%append $^&.mri END
+    $(noecho)ar -M < $^&.mri
+!  else
     $(bld_lib) $+$(libtarg_objs) $(libtarg_libs)$-
+!  endif
+! else
+    $(bld_lib) $+$(libtarg_objs) $(libtarg_libs)$-
+! endif
 !else ifeq __WATCOM_TOOLS__ 1290
     $(noecho)%create $(libtarg_name).lbc
     @for %o in ($+$(libtarg_opts) $(libtarg_objs) $(libtarg_libs)$-) do @%append $(libtarg_name).lbc %o
