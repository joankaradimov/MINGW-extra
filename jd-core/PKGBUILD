# Maintainer: Joan Karadimov <joan.karadimov@gmail.com>

_realname=jd-core
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.1.3
pkgrel=1
pkgdesc="Java decompiler library (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://java-decompiler.github.io/'
msys2_repository_url='https://github.com/java-decompiler/jd-core'
license=('spdx:GPL-3.0-only')
depends=("${MINGW_PACKAGE_PREFIX}-openjdk")
makedepends=('gradle')
source=("${_realname}-${pkgver}.tar.gz::https://github.com/java-decompiler/jd-core/archive/refs/tags/v${pkgver}.tar.gz"
        '0001-build-with-current-gradle.patch'
        '0002-recompile-test-output-for-a-release-javac-supports.patch'
        '0003-accept-method-parameters-without-a-name.patch'
        'test-jd-core.java')
sha256sums=('98dfdbef1e6ac1814bf5fe4b58027eb655d85b92abf266e957982dd09f7899ba'
            '84983015cc7cb3ccd82571a6ddc812606f8aa45b9bf63368c0e1ea0f5f4337c6'
            '1264b5cfa5f41e301ff8f36e58e113134b4e1dc8c73a8beb507bc4c40a7fe7b5'
            '0e732533798d81246ceb6611157a87276d58fd2cb7aecc7e0a22af20d3c6c67f'
            '9c92716f0449cd0e3acc17472d923ed4425df409136298520dd05ecfc332da52')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  local _p
  for _p in "${srcdir}"/00*.patch; do
    patch -Np1 -i "${_p}"
  done
}

_java_home() {
  local _jdk=("${MINGW_PREFIX}"/lib/jvm/java-*-openjdk)
  echo "${_jdk[0]}"
}

_gradle() {
  JAVA_HOME="$(_java_home)" GRADLE_USER_HOME="${srcdir}/gradle" \
    gradle --no-daemon "$@"
}

build() {
  cd "${srcdir}/${_realname}-${pkgver}"
  _gradle jar
}

check() {
  cd "${srcdir}/${_realname}-${pkgver}"
  _gradle test

  rm -rf "${srcdir}/test" && mkdir "${srcdir}/test"
  "$(_java_home)/bin/java" -cp "build/libs/${_realname}-${pkgver}.jar" \
    "${srcdir}/test-jd-core.java" "${srcdir}/test"
}

package() {
  cd "${srcdir}/${_realname}-${pkgver}"

  install -Dm644 "build/libs/${_realname}-${pkgver}.jar" \
    "${pkgdir}${MINGW_PREFIX}/share/java/${_realname}/${_realname}.jar"
  install -Dm644 LICENSE NOTICE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
